# --- Org / branding ----------------------------------------------------------
ROOT_DOMAIN=localhost:3000
ORG_NAME="All Seasons Storage"
ORG_SLUG=allseasons

# --- Supabase ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# --- Provider selection ------------------------------------------------------
# Start with everything on mock; flip individual providers to real at Phase 6.
PAYMENT_PROVIDER=mock
SMS_PROVIDER=mock
EMAIL_PROVIDER=mock

# --- Stripe (when PAYMENT_PROVIDER=stripe) -----------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- Twilio (when SMS_PROVIDER=twilio) ---------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Resend (when EMAIL_PROVIDER=resend) -------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Booking -----------------------------------------------------------------
UNIT_LOCK_DURATION_MINUTES=15

# --- Cron --------------------------------------------------------------------
# Required if you call /api/cron/expire-locks from Railway cron.
CRON_SECRET=

# --- Seeding -----------------------------------------------------------------
# Pick which seed file under seeds/ to run with `npm run seed`.
SEED=chandler
